[gd_resource type="Resource" script_class="NPCSchedule" format=3 uid="uid://dknkwuc1jkajv"]

[ext_resource type="Script" uid="uid://drrvt3h86ro54" path="res://NPC/data/npc_schedule.gd" id="1_entry"]
[ext_resource type="Script" uid="uid://nclx8evxr6qn" path="res://NPC/data/schedule_entry.gd" id="2_sched"]
[ext_resource type="Resource" uid="uid://dqp0r2nthw52q" path="res://NPC/data/activities/act_sleep.tres" id="3_sleep"]
