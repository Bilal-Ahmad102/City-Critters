MultiplayerGlobal="*res://Steam_Multiplayer/multiplayer_global.gd"
Multiplayer="*res://Steam_Multiplayer/network_manager.gd"
LocationRegistry="*uid://dqutrh2hpdbj2"

[debug]

shapes/navigation/3d/enable_agent_paths=false
shapes/navigation/2d/enable_agent_paths=false

[display]

window/size/mode=3

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

